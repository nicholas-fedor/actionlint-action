{
  "name": "actionlint-action",
  "version": "0.1.0",
  "description": "GitHub Action to run actionlint using official release binaries with checksum verification",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && ncc build lib/main.js -o dist --license licenses.txt",
    "prepare": "npm run build",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "keywords": [
    "github-action",
    "actionlint",
    "lint",
    "workflow"
  ],
  "author": "Nicholas Fedor",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^1.1.1",
    "@actions/github": "^6.0.0",
    "@actions/tool-cache": "^2.0.1"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "11.0.6",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.12.2",
    "@vercel/ncc": "0.38.4",
    "jest": "30.3.0",
    "semantic-release": "24.2.9",
    "ts-jest": "29.4.9",
    "typescript": "6.0.3"
  },
  "overrides": {
    "undici": "^8.0.0"
  }
}
