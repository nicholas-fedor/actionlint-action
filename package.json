{
  "name": "actionlint-action",
  "version": "0.1.0",
  "description": "GitHub Action to run actionlint using official release binaries with checksum verification",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "bun build src/main.ts --bundle --outfile=dist/index.js --target=node",
    "prepare": "bun run build",
    "test": "bun test",
    "test:coverage": "bun test --coverage"
  },
  "keywords": [
    "github-action",
    "actionlint",
    "lint",
    "workflow"
  ],
  "author": "Nicholas Fedor",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/github": "^9.1.1",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.6",
    "@semantic-release/release-notes-generator": "14.1.0",
    "@types/bun": "1.3.13",
    "@types/node": "25.6.0",
    "semantic-release": "25.0.3"
  },
  "overrides": {
    "undici": "^8.0.0"
  }
}
