{
  "repositoryUrl": "https://github.com/nicholas-fedor/actionlint-action",
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/github"
  ],
  "commitAnalyzer": {
    "releaseRules": [
      { "type": "chore", "release": true }
    ]
  }
}
