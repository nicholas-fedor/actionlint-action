{
  "repositoryUrl": "https://github.com/nicholas-fedor/actionlint-action",
  "branches": ["main"],
  "preset": "conventionalcommits",
  "presetConfig": {
    "types": [
      { "type": "feat", "section": "Features" },
      { "type": "fix", "section": "Bug Fixes" },
      { "type": "perf", "section": "Performance Improvements" },
      { "type": "revert", "section": "Reverts" }
    ]
  },
  "plugins": [
    {
      "path": "@semantic-release/commit-analyzer",
      "releaseRules": [
        { "type": "feat", "release": "minor" },
        { "type": "fix", "release": "patch" },
        { "type": "perf", "release": "patch" },
        { "type": "revert", "release": "patch" }
      ],
      "ignoreCommitsIfMessageMatches": [
        "^chore\\(deps\\): update (dependency )?@types/(node|bun)( to .+)?",
        "^chore\\(deps\\): update semantic-release monorepo",
        "^chore\\(deps\\): update dependency @semantic-release/",
        "^chore\\(deps\\): pin (dependency )?@types/bun"
      ]
    },
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", { "prepareCmd": "bun run build" }],
    "@semantic-release/github",
    [
      "@semantic-release/git",
      {
        "assets": ["dist/index.js"]
      }
    ]
  ]
}
