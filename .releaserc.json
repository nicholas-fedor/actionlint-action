{
  "repositoryUrl": "https://github.com/nicholas-fedor/actionlint-action",
  "branches": ["main"],
  "plugins": [
    {
      "path": "@semantic-release/commit-analyzer",
      "releaseRules": [
        { "type": "chore", "release": "patch" }
      ]
    },
    "@semantic-release/release-notes-generator",
    "@semantic-release/github"
  ]
}
